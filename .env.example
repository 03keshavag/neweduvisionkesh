# EduVision Video Generator - example environment
# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server port for `npm run serve` (defaults to 4000 — avoid 3000, used by Remotion)
PORT=4000

# Optional: TTS provider keys (added in a later stage)
# ELEVENLABS_API_KEY=
